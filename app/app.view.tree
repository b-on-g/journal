- The stock $mol_page marks its header caption as the page's h1. On an article
- that caption is the second one: the post itself opens with a real h1, and two
- competing top-level headings on a page is worse than none. Same body as the
- base declaration, only the tag changes — the caption stays where it was and
- keeps reading as a caption, it just stops claiming to be the heading.
$bog_journal_app $mol_page
	Title $mol_view
		dom_name \div
		sub <= title_content /
			<= Logo null
			<= title
	title <= screen_title \
	author_link \
	post_link \
	feed_link \
	edit_link \
	own_feed_link \
	title_journal @ \Journal
	title_feed @ \Feed
	title_post @ \Post
	title_edit @ \Editing
	journal_untitled @ \Unnamed journal
	plugins /
		<= Theme $mol_theme_auto
	tools <= tool_bar /
		<= Nav_feed $bog_journal_app_nav
			arg <= feed_arg *
			title @ \Feed
		<= Feed_make $mol_button_minor
			title @ \Feed
			hint @ \Start a reading feed
			click?event <=> feed_create?event null
		<= Nav_profile $bog_journal_app_nav
			arg <= profile_arg *
			title @ \Journal
		<= Nav_read $bog_journal_app_nav
			arg <= read_arg *
			title @ \View
		<= Nav_edit $bog_journal_app_nav
			arg <= edit_arg *
			title @ \Edit
		<= Post_new $mol_button_minor
			title @ \New post
			click?event <=> post_create?event null
		<= Registry_add $mol_button_minor
			title @ \List publicly
			hint @ \Add this journal to the public directory
			click?event <=> registry_add?event null
		- Icon rather than the language's name: spelled out it took the toolbar
		- onto a second row on a phone, and it sits next to two other icon
		- controls anyway. Which language is on is visible from the whole page.
		<= Lang $mol_button_minor
			hint @ \Switch language
			click?event <=> lang_toggle?event null
			sub /
				<= Lang_icon $mol_icon_translate
		<= Status $giper_baza_status
		<= Lights $mol_lights_toggle
	body <= app_content /
		<= Profile $bog_journal_profile
			author_link <= author_link
		<= Post $bog_journal_post_page
			post_link <= post_link
		<= Feed $bog_journal_feed_page
			feed_link <= feed_link
		<= Edit $bog_journal_edit_page
			post_link <= edit_link
			author_link <= author_link
